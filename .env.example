# ---- AI provider ----
# One of: deepseek | anthropic | openai-compatible
AI_PROVIDER=deepseek

# deepseek
DEEPSEEK_API_KEY=

# anthropic
ANTHROPIC_API_KEY=

# openai-compatible / local (Ollama, LM Studio, vLLM)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
# Override the model for any provider (optional)
AI_MODEL=

# ---- Backend ----
PORT=8080
MONGO_URL=mongodb://mongo:27017/aegis
REDIS_URL=redis://redis:6379
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:3000

# ---- Kali worker ----
# Shared secret between backend and worker exec-agent. CHANGE THIS.
WORKER_TOKEN=change-me-worker-token
WORKER_URL=http://worker:7000

# ---- Auth ----
# Secret used to sign login tokens. Set a long random value (openssl rand -hex 32).
# If left blank, a random secret is generated per boot (logins drop on restart).
JWT_SECRET=
TOKEN_TTL_HOURS=12
# First-run admin account (change the password for anything beyond local use).
# If ADMIN_PASSWORD is blank, a random one is generated and printed to the logs.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin1234

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8080

# ---- Production deploy (docker-compose.prod.yml) ----
# The domain pointed at this server; Caddy gets HTTPS for it automatically.
PUBLIC_DOMAIN=aegis.example.com
# Full public origin (used for backend CORS). Must match the domain above.
PUBLIC_URL=https://aegis.example.com
